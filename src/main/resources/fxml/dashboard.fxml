<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.loanmanagement.controller.DashboardController"
            stylesheets="@../css/dashboard.css"
            styleClass="dashboard-root">


    <!-- ========================================================= -->
    <!-- TOP BAR -->
    <!-- ========================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="top-bar">

            <padding>
                <Insets top="18"
                        right="28"
                        bottom="18"
                        left="28"/>
            </padding>


            <!-- LOGO -->

            <VBox spacing="3">

                <Label text="LOANFLOW"
                       styleClass="dashboard-logo"/>

                <Label text="LOAN MANAGEMENT SYSTEM"
                       styleClass="dashboard-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <!-- USER INFORMATION -->

            <VBox alignment="CENTER_RIGHT"
                  spacing="2">

                <Label fx:id="welcomeLabel"
                       text="Welcome"
                       styleClass="welcome-label"/>

                <Label fx:id="roleLabel"
                       text="Customer"
                       styleClass="role-label"/>

            </VBox>


            <!-- REFRESH -->

            <Button text="↻  Refresh"
                    styleClass="refresh-button"
                    onAction="#refreshDashboard"/>


            <!-- LOGOUT -->

            <Button text="Logout"
                    styleClass="logout-button"
                    onAction="#logout"/>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    styleClass="dashboard-scroll">


            <VBox spacing="25">

                <padding>
                    <Insets top="30"
                            right="35"
                            bottom="35"
                            left="35"/>
                </padding>


                <!-- ================================================= -->
                <!-- PAGE TITLE -->
                <!-- ================================================= -->

                <VBox spacing="6">

                    <Label fx:id="pageTitleLabel"
                           text="Dashboard"
                           styleClass="page-title"/>

                    <Label fx:id="pageDescriptionLabel"
                           text="Overview of your loan management activities"
                           styleClass="page-description"/>

                </VBox>


                <!-- ================================================= -->
                <!-- STAT CARDS -->
                <!-- ================================================= -->

                <GridPane hgap="18"
                          vgap="18">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    </columnConstraints>


                    <!-- CUSTOMERS -->

                    <VBox GridPane.columnIndex="0"
                          GridPane.rowIndex="0"
                          maxWidth="Infinity"
                          styleClass="stat-card">

                        <padding>
                            <Insets top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>
                        </padding>

                        <Label fx:id="customersCardLabel"
                               text="CUSTOMERS"
                               styleClass="card-label"/>

                        <Label fx:id="customersValueLabel"
                               text="0"
                               styleClass="card-value"/>

                        <Label fx:id="customersCardDescription"
                               text="Registered customers"
                               styleClass="card-description"/>

                    </VBox>


                    <!-- APPLICATIONS -->

                    <VBox GridPane.columnIndex="1"
                          GridPane.rowIndex="0"
                          maxWidth="Infinity"
                          styleClass="stat-card">

                        <padding>
                            <Insets top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>
                        </padding>

                        <Label fx:id="applicationsCardLabel"
                               text="APPLICATIONS"
                               styleClass="card-label"/>

                        <Label fx:id="applicationsValueLabel"
                               text="0"
                               styleClass="card-value"/>

                        <Label fx:id="applicationsCardDescription"
                               text="Loan applications"
                               styleClass="card-description"/>

                    </VBox>


                    <!-- ACTIVE LOANS -->

                    <VBox GridPane.columnIndex="2"
                          GridPane.rowIndex="0"
                          maxWidth="Infinity"
                          styleClass="stat-card">

                        <padding>
                            <Insets top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>
                        </padding>

                        <Label fx:id="loansCardLabel"
                               text="ACTIVE LOANS"
                               styleClass="card-label"/>

                        <Label fx:id="loansValueLabel"
                               text="0"
                               styleClass="card-value"/>

                        <Label fx:id="loansCardDescription"
                               text="Currently active"
                               styleClass="card-description"/>

                    </VBox>


                    <!-- PAYMENTS -->

                    <VBox GridPane.columnIndex="3"
                          GridPane.rowIndex="0"
                          maxWidth="Infinity"
                          styleClass="stat-card">

                        <padding>
                            <Insets top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>
                        </padding>

                        <Label fx:id="paymentsCardLabel"
                               text="PAYMENTS"
                               styleClass="card-label"/>

                        <Label fx:id="paymentsValueLabel"
                               text="0"
                               styleClass="card-value"/>

                        <Label fx:id="paymentsCardDescription"
                               text="Recorded payments"
                               styleClass="card-description"/>

                    </VBox>

                </GridPane>


                <!-- ================================================= -->
                <!-- LOWER SECTION -->
                <!-- ================================================= -->

                <HBox spacing="20">


                    <!-- ================================================= -->
                    <!-- RECENT ACTIVITY -->
                    <!-- ================================================= -->

                    <VBox HBox.hgrow="ALWAYS"
                          styleClass="content-card">

                        <padding>
                            <Insets top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>
                        </padding>


                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="4">

                                <Label text="Recent Activity"
                                       styleClass="section-title"/>

                                <Label text="Latest loan management activity"
                                       styleClass="section-description"/>

                            </VBox>


                            <Region HBox.hgrow="ALWAYS"/>


                            <Button text="↻"
                                    styleClass="small-refresh-button"
                                    onAction="#refreshDashboard"/>

                        </HBox>


                        <VBox fx:id="activityContainer"
                              spacing="12"
                              styleClass="activity-container">

                            <Label text="No recent activity available."
                                   styleClass="empty-label"/>

                        </VBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- QUICK ACTIONS -->
                    <!-- ================================================= -->

                    <VBox prefWidth="300"
                          spacing="10"
                          styleClass="content-card">

                        <padding>
                            <Insets top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>
                        </padding>


                        <Label text="Quick Actions"
                               styleClass="section-title"/>

                        <Label text="Access commonly used features"
                               styleClass="section-description"/>


                        <Region prefHeight="8"/>


                        <!-- ================================================= -->
                        <!-- CUSTOMER: APPLY LOAN -->
                        <!-- ================================================= -->

                        <Button fx:id="applyLoanButton"
                                text="+  Apply for Loan"
                                maxWidth="Infinity"
                                prefHeight="44"
                                styleClass="action-button"
                                onAction="#applyLoan"/>


                        <!-- ================================================= -->
                        <!-- CUSTOMER: VIEW LOANS -->
                        <!-- ================================================= -->

                        <Button fx:id="viewLoansButton"
                                text="▣  View Loans"
                                maxWidth="Infinity"
                                prefHeight="44"
                                styleClass="secondary-action-button"
                                onAction="#viewLoans"/>


                        <!-- ================================================= -->
                        <!-- CUSTOMER: PAYMENT HISTORY -->
                        <!-- ================================================= -->

                        <Button fx:id="viewPaymentsButton"
                                text="₹  Payment History"
                                maxWidth="Infinity"
                                prefHeight="44"
                                styleClass="secondary-action-button"
                                onAction="#viewPayments"/>


                        <!-- ================================================= -->
                        <!-- LOAN OFFICER: PENDING APPLICATIONS -->
                        <!-- ================================================= -->

                        <Button fx:id="pendingApplicationsButton"
                                text="▣  Pending Applications"
                                maxWidth="Infinity"
                                prefHeight="44"
                                styleClass="secondary-action-button"
                                onAction="#openPendingApplications"/>

                        <Button fx:id="loanPortfolioButton"
                                text="Loan Portfolio"
                                maxWidth="Infinity"
                                prefHeight="44"
                                styleClass="secondary-action-button"
                                onAction="#openLoanPortfolioPage"/>

                        <Button fx:id="userManagementButton"
                                text="User Management"
                                maxWidth="Infinity"
                                prefHeight="44"
                                styleClass="secondary-action-button"
                                onAction="#openUserManagement"/>

                    </VBox>

                </HBox>


                <!-- ================================================= -->
                <!-- QUOTE -->
                <!-- ================================================= -->

                <HBox alignment="CENTER"
                      styleClass="dashboard-quote">

                    <Label text="“Plan wisely. Borrow smartly. Build your future.”"
                           styleClass="quote-label"/>

                </HBox>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>
