<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.loanmanagement.controller.LoanManagementController"
            stylesheets="@../css/dashboard.css" styleClass="dashboard-root">
    <top><HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar"><padding><Insets top="16" right="28" bottom="16" left="28"/></padding><VBox><Label text="LoanFlow" styleClass="dashboard-logo"/><Label text="SIMPLE LENDING • SMARTER DECISIONS" styleClass="dashboard-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh" styleClass="refresh-button"/><Button text="Back to Dashboard" onAction="#back" styleClass="logout-button"/></HBox></top>
    <center><ScrollPane fitToWidth="true" styleClass="dashboard-scroll"><VBox spacing="20"><padding><Insets top="28" right="32" bottom="32" left="32"/></padding>
        <VBox spacing="5"><Label fx:id="titleLabel" text="Loans" styleClass="page-title"/><Label fx:id="descriptionLabel" text="Loan portfolio" styleClass="page-description"/></VBox>
        <VBox spacing="12" styleClass="content-card"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><Label text="My applications" styleClass="section-title"/>
            <TableView fx:id="applicationTable" prefHeight="220" styleClass="application-table"><placeholder><Label text="No loan applications found." styleClass="empty-label"/></placeholder><columns>
                <TableColumn fx:id="applicationIdColumn" text="Application"/><TableColumn fx:id="applicationTypeColumn" text="Loan type"/><TableColumn fx:id="applicationAmountColumn" text="Amount"/><TableColumn fx:id="applicationPurposeColumn" text="Purpose"/><TableColumn fx:id="applicationTenureColumn" text="Months"/><TableColumn fx:id="applicationInterestColumn" text="Interest %"/><TableColumn fx:id="applicationEmiColumn" text="EMI"/><TableColumn fx:id="applicationDateColumn" text="Applied on"/><TableColumn fx:id="applicationStatusColumn" text="Status"/>
            </columns></TableView>
        </VBox>
        <VBox spacing="12" styleClass="content-card"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><HBox alignment="CENTER_LEFT" spacing="12"><Label text="Loan accounts" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="loanSearchField" promptText="Search by loan ID, application ID, or customer" styleClass="modern-field"/><ComboBox fx:id="loanFilterCombo" prefWidth="145" styleClass="modern-combo"/></HBox>
            <TableView fx:id="loanTable" prefHeight="290" styleClass="loan-table"><placeholder><Label text="No loans match the current search or filter." styleClass="empty-label"/></placeholder><columns>
                <TableColumn fx:id="loanIdColumn" text="Loan ID"/><TableColumn fx:id="loanApplicationIdColumn" text="Application"/><TableColumn fx:id="customerColumn" text="Customer"/><TableColumn fx:id="amountColumn" text="Amount"/><TableColumn fx:id="interestColumn" text="Interest %"/><TableColumn fx:id="tenureColumn" text="Months"/><TableColumn fx:id="emiColumn" text="EMI"/><TableColumn fx:id="totalRepayableColumn" text="Total repayable"/><TableColumn fx:id="totalPaidColumn" text="Total paid"/><TableColumn fx:id="outstandingColumn" text="Outstanding"/><TableColumn fx:id="startColumn" text="Start date"/><TableColumn fx:id="statusColumn" text="Status"/>
            </columns></TableView>
        </VBox>
        <HBox spacing="20"><VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="content-card"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><HBox alignment="CENTER_LEFT"><VBox><Label fx:id="selectedLoanLabel" text="No loan selected" styleClass="section-title"/><Label fx:id="balanceLabel" text="-" styleClass="section-description"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="statementButton" text="View Loan Statement" onAction="#openStatement" styleClass="secondary-action-button"/></HBox>
            <GridPane hgap="22" vgap="8" styleClass="repayment-summary"><Label text="Original amount" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/><Label fx:id="originalAmountLabel" text="-" styleClass="summary-value" GridPane.columnIndex="0" GridPane.rowIndex="1"/><Label text="Total repayable" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/><Label fx:id="totalRepayableLabel" text="-" styleClass="summary-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="Total paid" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/><Label fx:id="totalPaidLabel" text="-" styleClass="summary-value" GridPane.columnIndex="2" GridPane.rowIndex="1"/><Label text="Outstanding" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="0"/><Label fx:id="outstandingLabel" text="-" styleClass="summary-value" GridPane.columnIndex="3" GridPane.rowIndex="1"/><Label text="EMI" styleClass="field-label" GridPane.columnIndex="4" GridPane.rowIndex="0"/><Label fx:id="emiLabel" text="-" styleClass="summary-value" GridPane.columnIndex="4" GridPane.rowIndex="1"/><Label text="Payments made" styleClass="field-label" GridPane.columnIndex="5" GridPane.rowIndex="0"/><Label fx:id="paymentsMadeLabel" text="-" styleClass="summary-value" GridPane.columnIndex="5" GridPane.rowIndex="1"/></GridPane>
            <HBox alignment="CENTER_LEFT" spacing="12"><Label text="Payment history for this loan" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="paymentSearchField" promptText="Search payment ID, method, reference" styleClass="modern-field"/><ComboBox fx:id="paymentFilterCombo" prefWidth="135" styleClass="modern-combo"/></HBox>
            <TableView fx:id="paymentTable" prefHeight="210" styleClass="payment-table"><placeholder><VBox alignment="CENTER" spacing="5"><Label text="Payment history is ready" styleClass="empty-title"/><Label text="Recorded repayments for the selected loan will appear here." styleClass="empty-label"/></VBox></placeholder><columns><TableColumn fx:id="paymentIdColumn" text="Payment ID"/><TableColumn fx:id="paymentDateColumn" text="Date"/><TableColumn fx:id="paymentAmountColumn" text="Amount"/><TableColumn fx:id="paymentMethodColumn" text="Method"/><TableColumn fx:id="paymentReferenceColumn" text="Reference"/><TableColumn fx:id="paymentStatusColumn" text="Status"/></columns></TableView>
        </VBox>
        <VBox prefWidth="300" spacing="12" styleClass="content-card"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><Label text="Record repayment" styleClass="section-title"/><Label text="The selected loan will receive this payment." styleClass="section-description" wrapText="true"/><Label text="Amount" styleClass="field-label"/><TextField fx:id="paymentAmountField" promptText="Enter amount" styleClass="modern-field"/><Label fx:id="remainingAfterPaymentLabel" text="Select a loan to see repayment details." styleClass="payment-preview" wrapText="true"/><Label text="Method" styleClass="field-label"/><ComboBox fx:id="paymentMethodCombo" promptText="Select method" maxWidth="Infinity" styleClass="modern-combo"/><Label text="Reference" styleClass="field-label"/><TextField fx:id="paymentReferenceField" promptText="Optional reference" styleClass="modern-field"/><Button fx:id="recordPaymentButton" text="Record Payment" maxWidth="Infinity" onAction="#recordPayment" styleClass="action-button"/></VBox></HBox>
    </VBox></ScrollPane></center>
</BorderPane>
