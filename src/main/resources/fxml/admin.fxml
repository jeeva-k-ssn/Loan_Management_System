<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.chart.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.loanmanagement.controller.AdminController" stylesheets="@../css/dashboard.css" styleClass="dashboard-root">
 <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar"><padding><Insets top="16" right="28" bottom="16" left="28"/></padding><VBox><Label text="LoanFlow" styleClass="dashboard-logo"/><Label text="ADMINISTRATION" styleClass="dashboard-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh" styleClass="refresh-button"/><Button text="Back" onAction="#back" styleClass="logout-button"/></HBox></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll"><VBox spacing="18" fillWidth="true"><padding><Insets top="28" right="34" bottom="34" left="34"/></padding>
  <VBox spacing="5"><Label text="Administration" styleClass="page-title"/><Label text="Monitor application activity and manage operational access." styleClass="page-description"/></VBox>
  <GridPane hgap="12" vgap="12"><VBox styleClass="stat-card" GridPane.columnIndex="0"><Label text="CUSTOMERS" styleClass="card-label"/><Label fx:id="totalCustomersLabel" text="-" styleClass="card-value"/><Label text="Registered" styleClass="card-description"/></VBox><VBox styleClass="stat-card" GridPane.columnIndex="1"><Label text="NEW CUSTOMERS" styleClass="card-label"/><Label fx:id="newCustomersLabel" text="-" styleClass="card-value"/><Label text="Last 30 days" styleClass="card-description"/></VBox><VBox styleClass="stat-card" GridPane.columnIndex="2"><Label text="ACTIVE CUSTOMERS" styleClass="card-label"/><Label fx:id="activeCustomersLabel" text="-" styleClass="card-value"/><Label text="With active loans" styleClass="card-description"/></VBox><VBox styleClass="stat-card" GridPane.columnIndex="3"><Label text="PENDING" styleClass="card-label"/><Label fx:id="pendingApplicationsLabel" text="-" styleClass="card-value"/><Label text="Applications to review" styleClass="card-description"/></VBox><VBox styleClass="stat-card" GridPane.columnIndex="4"><Label text="ACTIVE LOANS" styleClass="card-label"/><Label fx:id="activeLoansLabel" text="-" styleClass="card-value"/><Label text="Currently open" styleClass="card-description"/></VBox></GridPane>
  <HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="content-card"><Label text="TOTAL DISBURSED" styleClass="card-label"/><Label fx:id="totalDisbursedLabel" text="-" styleClass="summary-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="content-card"><Label text="TOTAL COLLECTED" styleClass="card-label"/><Label fx:id="totalCollectedLabel" text="-" styleClass="summary-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="content-card"><Label text="TOTAL OUTSTANDING" styleClass="card-label"/><Label fx:id="totalOutstandingLabel" text="-" styleClass="summary-value"/></VBox></HBox>
  <TabPane tabClosingPolicy="UNAVAILABLE"><tabs>
   <Tab text="Users"><VBox spacing="14" styleClass="content-card"><TextField fx:id="userSearchField" promptText="Search users by name, email, role, or ID" styleClass="modern-field"/><TableView fx:id="userTable" styleClass="admin-table"><columns><TableColumn fx:id="idColumn" text="ID"/><TableColumn fx:id="nameColumn" text="Full name"/><TableColumn fx:id="emailColumn" text="Email"/><TableColumn fx:id="roleColumn" text="Role"/></columns></TableView><HBox spacing="12" alignment="CENTER_LEFT"><Label fx:id="selectedLabel" text="No user selected" styleClass="section-description"/><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="roleCombo" prefWidth="180"/><Button fx:id="saveButton" text="Save role" onAction="#saveRole" styleClass="action-button"/></HBox></VBox></Tab>
   <Tab text="Applications"><VBox spacing="14" styleClass="content-card"><HBox alignment="CENTER_LEFT" spacing="12"><Label text="All loan applications" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="applicationSearchField" promptText="Search application or customer" styleClass="modern-field"/><ComboBox fx:id="applicationFilterCombo" prefWidth="125" styleClass="modern-combo"/></HBox><TableView fx:id="applicationTable" styleClass="admin-table"><columns><TableColumn fx:id="applicationIdColumn" text="Application ID"/><TableColumn fx:id="applicationCustomerColumn" text="Customer"/><TableColumn fx:id="applicationTypeColumn" text="Loan type"/><TableColumn fx:id="applicationAmountColumn" text="Amount"/><TableColumn fx:id="applicationDateColumn" text="Applied on"/><TableColumn fx:id="applicationStatusColumn" text="Status"/></columns></TableView></VBox></Tab>
   <Tab text="Customers"><VBox spacing="14" styleClass="content-card"><HBox alignment="CENTER_LEFT" spacing="12"><Label text="Customer portfolio" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="customerSearchField" promptText="Search customer by ID, name, email, or phone" styleClass="modern-field"/><ComboBox fx:id="customerFilterCombo" prefWidth="175" styleClass="modern-combo"/><Button fx:id="viewCustomerButton" text="View profile" onAction="#openCustomerProfile" styleClass="secondary-action-button"/></HBox><TableView fx:id="customerTable" styleClass="admin-table"><placeholder><Label text="No customers found" styleClass="empty-label"/></placeholder><columns><TableColumn fx:id="customerIdColumn" text="Customer ID"/><TableColumn fx:id="customerNameColumn" text="Name"/><TableColumn fx:id="customerEmailColumn" text="Email"/><TableColumn fx:id="customerPhoneColumn" text="Phone"/><TableColumn fx:id="customerAddressColumn" text="Address"/><TableColumn fx:id="customerApplicationsColumn" text="Applications"/><TableColumn fx:id="customerLoansColumn" text="Loans"/><TableColumn fx:id="customerBorrowedColumn" text="Borrowed"/><TableColumn fx:id="customerOutstandingColumn" text="Outstanding"/></columns></TableView></VBox></Tab>
   <Tab text="Payments"><VBox spacing="14" styleClass="content-card"><HBox alignment="CENTER_LEFT" spacing="12"><Label text="Payment portfolio" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="paymentSearchField" promptText="Search payment, loan, customer, or reference" styleClass="modern-field"/><ComboBox fx:id="paymentFilterCombo" prefWidth="110" styleClass="modern-combo"/></HBox><TableView fx:id="paymentTable" styleClass="admin-table"><columns><TableColumn fx:id="paymentIdColumn" text="Payment ID"/><TableColumn fx:id="paymentLoanIdColumn" text="Loan ID"/><TableColumn fx:id="paymentCustomerColumn" text="Customer"/><TableColumn fx:id="paymentDateColumn" text="Date"/><TableColumn fx:id="paymentAmountColumn" text="Amount"/><TableColumn fx:id="paymentMethodColumn" text="Method"/><TableColumn fx:id="paymentReferenceColumn" text="Reference"/><TableColumn fx:id="paymentStatusColumn" text="Status"/></columns></TableView></VBox></Tab>
   <Tab text="Reports"><VBox spacing="14" styleClass="content-card"><Label text="Portfolio statistics" styleClass="section-title"/><HBox spacing="10"><VBox HBox.hgrow="ALWAYS" styleClass="stat-card"><Label text="TOTAL APPLICATIONS" styleClass="card-label"/><Label fx:id="totalApplicationsReportLabel" text="-" styleClass="card-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stat-card"><Label text="PENDING" styleClass="card-label"/><Label fx:id="pendingApplicationsReportLabel" text="-" styleClass="card-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stat-card"><Label text="APPROVED" styleClass="card-label"/><Label fx:id="approvedApplicationsReportLabel" text="-" styleClass="card-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stat-card"><Label text="REJECTED" styleClass="card-label"/><Label fx:id="rejectedApplicationsReportLabel" text="-" styleClass="card-value"/></VBox></HBox><HBox spacing="10"><VBox HBox.hgrow="ALWAYS" styleClass="stat-card"><Label text="TOTAL LOANS" styleClass="card-label"/><Label fx:id="totalLoansReportLabel" text="-" styleClass="card-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stat-card"><Label text="ACTIVE" styleClass="card-label"/><Label fx:id="activeLoansReportLabel" text="-" styleClass="card-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="stat-card"><Label text="CLOSED" styleClass="card-label"/><Label fx:id="closedLoansReportLabel" text="-" styleClass="card-value"/></VBox></HBox><HBox spacing="18"><VBox HBox.hgrow="ALWAYS"><Label text="Application status" styleClass="section-title"/><PieChart fx:id="applicationChart" prefHeight="260" title="Applications"/><Label text="Loan status" styleClass="section-title"/><PieChart fx:id="loanChart" prefHeight="260" title="Loans"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Financial overview" styleClass="section-title"/><BarChart fx:id="financialChart" prefHeight="300" title="Portfolio amounts"><xAxis><CategoryAxis label="Category"/></xAxis><yAxis><NumberAxis label="Amount"/></yAxis></BarChart><Label text="Monthly application trend" styleClass="section-title"/><LineChart fx:id="monthlyApplicationChart" prefHeight="280" title="Applications by month"><xAxis><CategoryAxis label="Month"/></xAxis><yAxis><NumberAxis label="Applications"/></yAxis></LineChart></VBox></HBox></VBox></Tab>
  </tabs></TabPane>
 </VBox></ScrollPane></center>
</BorderPane>
