<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.loanmanagement.controller.ForgotPasswordController"
      spacing="12" prefWidth="430" styleClass="forgot-password-content">
    <padding>
        <Insets top="24" right="26" bottom="20" left="26"/>
    </padding>
    <Label text="Reset your password" styleClass="forgot-title"/>
    <Label text="Use the email and role registered with LoanFlow. Your new password will be securely hashed before it is saved." wrapText="true" styleClass="forgot-subtitle"/>

    <Label text="EMAIL ADDRESS" styleClass="forgot-field-label"/>
    <TextField fx:id="emailField" promptText="Registered email address" styleClass="forgot-field"/>

    <Label text="ACCOUNT ROLE" styleClass="forgot-field-label"/>
    <ComboBox fx:id="roleComboBox" maxWidth="Infinity" styleClass="forgot-field"/>

    <Label text="NEW PASSWORD" styleClass="forgot-field-label"/>
    <PasswordField fx:id="newPasswordField" promptText="At least 8 characters" styleClass="forgot-field"/>

    <Label text="CONFIRM PASSWORD" styleClass="forgot-field-label"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your new password" styleClass="forgot-field"/>

    <Label fx:id="statusLabel" wrapText="true" styleClass="forgot-status"/>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" onAction="#cancel" styleClass="forgot-cancel-button"/>
        <Button fx:id="resetButton" text="Reset Password" onAction="#resetPassword" defaultButton="true" styleClass="forgot-reset-button"/>
    </HBox>
</VBox>
