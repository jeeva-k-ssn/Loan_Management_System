<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.loanmanagement.controller.LoginController"
           stylesheets="@../css/login.css" styleClass="login-root">
    
    <!-- Main Split Shell -->
    <GridPane styleClass="login-shell" prefHeight="900" minHeight="620">
        <columnConstraints>
            <ColumnConstraints percentWidth="54" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="46" hgrow="ALWAYS"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" percentHeight="100"/>
        </rowConstraints>
        
        <!-- Left Hero Panel -->
        <StackPane fx:id="loginBrandPanel" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS" GridPane.hgrow="ALWAYS" styleClass="hero-panel">
            <!-- Ambient Gradient Overlay over Background Image -->
            <Region styleClass="hero-overlay"/>
            
            <VBox styleClass="hero-content" fillWidth="true" VBox.vgrow="ALWAYS" StackPane.alignment="CENTER">
                <!-- Brand Header -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="brand-logo-icon-bg">
                        <SVGPath content="M17 3H7c-1.1 0-1.99.9-1.99 2L5 19c0 1.1.89 2 1.99 2H17c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z" fill="#00F2FE" styleClass="brand-svg"/>
                    </StackPane>
                    <VBox spacing="0">
                        <HBox spacing="0">
                            <Label text="Loan" styleClass="brand-title-white"/>
                            <Label text="Flow" styleClass="brand-title-cyan"/>
                        </HBox>
                        <Label text="Loan Management System" styleClass="brand-subtitle"/>
                    </VBox>
                </HBox>

                <Region prefHeight="58" maxHeight="58"/>

                <!-- Main Hero Copy & Badges -->
                <VBox spacing="24" maxWidth="560">
                    <VBox spacing="4">
                        <Label text="Smarter Lending." styleClass="hero-heading-white"/>
                        <HBox spacing="10">
                            <Label text="Simpler" styleClass="hero-heading-cyan"/>
                            <Label text="Management." styleClass="hero-heading-white"/>
                        </HBox>
                    </VBox>

                    <Label text="Your dreams deserve the right support.&#10;LoanFlow makes loan applications, approvals&#10;and repayments easier, faster and more secure." styleClass="hero-copy" wrapText="true" maxWidth="500"/>

                    <!-- 4 Feature Cards -->
                    <HBox spacing="12" styleClass="feature-row">
                        <VBox styleClass="feature-card" alignment="TOP_LEFT" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="feature-icon-badge">
                                <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" fill="#00F2FE" styleClass="feature-svg"/>
                            </StackPane>
                            <Label text="Secure&#10;&amp; Reliable" styleClass="feature-text"/>
                        </VBox>

                        <VBox styleClass="feature-card" alignment="TOP_LEFT" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="feature-icon-badge">
                                <SVGPath content="M7 2v11h3v9l7-12h-4l4-8z" fill="#00F2FE" styleClass="feature-svg"/>
                            </StackPane>
                            <Label text="Faster&#10;Approvals" styleClass="feature-text"/>
                        </VBox>

                        <VBox styleClass="feature-card" alignment="TOP_LEFT" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="feature-icon-badge">
                                <SVGPath content="M5 9.2h3V19H5zM10.6 5h3v14h-3zM16.2 13h3v6h-3z" fill="#00F2FE" styleClass="feature-svg"/>
                            </StackPane>
                            <Label text="Better&#10;Financial Control" styleClass="feature-text"/>
                        </VBox>

                        <VBox styleClass="feature-card" alignment="TOP_LEFT" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="feature-icon-badge">
                                <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="#00F2FE" styleClass="feature-svg"/>
                            </StackPane>
                            <Label text="Built for a&#10;Brighter Future" styleClass="feature-text"/>
                        </VBox>
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox styleClass="quote-box" spacing="12" alignment="CENTER_LEFT">
                    <Region styleClass="quote-accent-bar"/>
                    <Label text="&#8220;" styleClass="quote-mark"/>
                    <Label text="Better financial decisions today,&#10;a stronger tomorrow." styleClass="quote-text" wrapText="true" maxWidth="430"/>
                </HBox>
            </VBox>
        </StackPane>

        <!-- Right Login Panel -->
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS" GridPane.hgrow="ALWAYS" styleClass="login-panel">
            <HBox alignment="CENTER_RIGHT" spacing="12" mouseTransparent="true" styleClass="top-right-tagline">
                <Region styleClass="tagline-bar"/>
                <Label text="Smarter Lending. Brighter Futures." styleClass="tagline-text"/>
            </HBox>

            <StackPane styleClass="login-card-stage" alignment="CENTER" VBox.vgrow="ALWAYS">
                <VBox maxWidth="540" prefWidth="520" maxHeight="-Infinity" spacing="14" styleClass="login-card">
                <padding>
                    <Insets top="34" right="38" bottom="32" left="38"/>
                </padding>

                <!-- Header inside Card -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane styleClass="card-logo-badge">
                        <SVGPath content="M17 3H7c-1.1 0-1.99.9-1.99 2L5 19c0 1.1.89 2 1.99 2H17c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z" fill="#00F2FE" styleClass="card-logo-svg"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Welcome Back" styleClass="kicker-text"/>
                        <HBox spacing="6">
                            <Label text="Sign in to" styleClass="card-title-white"/>
                            <Label text="LoanFlow" styleClass="card-title-cyan"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Label text="Use your credentials to continue your journey." styleClass="card-subtitle"/>

                <!-- Email Input -->
                <VBox spacing="6">
                    <Label text="EMAIL ADDRESS" styleClass="field-label"/>
                    <HBox alignment="CENTER_LEFT" styleClass="input-container">
                        <StackPane styleClass="input-icon-box">
                            <SVGPath content="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" fill="#94BCCB" styleClass="input-svg"/>
                        </StackPane>
                        <TextField fx:id="emailField" promptText="Enter your email address" styleClass="custom-input" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Password Input -->
                <VBox spacing="6">
                    <Label text="PASSWORD" styleClass="field-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="6" styleClass="input-container">
                        <StackPane styleClass="input-icon-box">
                            <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" fill="#94BCCB" styleClass="input-svg"/>
                        </StackPane>
                        <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="custom-input" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="visiblePasswordField" managed="false" visible="false" promptText="Enter your password" styleClass="custom-input" HBox.hgrow="ALWAYS"/>
                        <ToggleButton fx:id="passwordToggle" text="Show" onAction="#togglePassword" styleClass="eye-toggle-btn">
                            <graphic>
                                <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="#00F2FE" styleClass="eye-svg"/>
                            </graphic>
                        </ToggleButton>
                    </HBox>
                </VBox>

                <!-- Role Input -->
                <VBox spacing="6">
                    <Label text="LOGIN AS" styleClass="field-label"/>
                    <HBox alignment="CENTER_LEFT" styleClass="input-container">
                        <StackPane styleClass="input-icon-box">
                            <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#94BCCB" styleClass="input-svg"/>
                        </StackPane>
                        <ComboBox fx:id="roleComboBox" maxWidth="Infinity" styleClass="custom-combo" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Submit Button -->
                <Button text="→   Sign In" maxWidth="Infinity" prefHeight="48" styleClass="sign-in-btn" onAction="#loginUser"/>

                <!-- Register Link Row -->
                <HBox alignment="CENTER" spacing="6">
                    <Label text="New to LoanFlow?" styleClass="register-prompt"/>
                    <Hyperlink text="Register as Customer  ›" styleClass="register-link" onAction="#openRegister"/>
                </HBox>

                <Separator styleClass="card-divider"/>

                <!-- Security Note -->
                <HBox alignment="CENTER" spacing="8">
                    <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" fill="#00F2FE" styleClass="security-svg"/>
                    <Label text="Your data is protected with bank-grade security." styleClass="security-note" wrapText="true"/>
                </HBox>
                </VBox>
            </StackPane>
        </VBox>
    </GridPane>

</StackPane>
