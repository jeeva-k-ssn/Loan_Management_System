<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.loanmanagement.controller.LoginController" stylesheets="@../css/login.css" styleClass="login-root">
 <HBox maxWidth="Infinity" maxHeight="Infinity" styleClass="login-shell">
  <VBox HBox.hgrow="ALWAYS" spacing="20" styleClass="login-brand-panel"><padding><Insets top="42" right="54" bottom="42" left="58"/></padding>
   <VBox spacing="2"><Label text="LoanFlow" styleClass="brand-logo"/><Label text="Loan Management System" styleClass="brand-subtitle"/></VBox><Region VBox.vgrow="ALWAYS"/>
   <VBox spacing="12" maxWidth="570"><Label text="Smarter Lending." styleClass="brand-headline"/><Label text="Simpler Management." styleClass="brand-headline-accent"/><Label text="Your dreams deserve the right support. LoanFlow makes loan applications, approvals and repayments easier, faster and more secure." styleClass="brand-copy" wrapText="true"/></VBox>
   <HBox spacing="10" styleClass="feature-row"><VBox styleClass="feature-card"><Label text="✓" styleClass="feature-icon"/><Label text="Secure&#10;&amp; Reliable" styleClass="feature-text"/></VBox><VBox styleClass="feature-card"><Label text="↗" styleClass="feature-icon"/><Label text="Faster&#10;Approvals" styleClass="feature-text"/></VBox><VBox styleClass="feature-card"><Label text="▥" styleClass="feature-icon"/><Label text="Better&#10;Financial Control" styleClass="feature-text"/></VBox><VBox styleClass="feature-card"><Label text="♙" styleClass="feature-icon"/><Label text="Built for a&#10;Brighter Future" styleClass="feature-text"/></VBox></HBox>
   <Label text="Better financial decisions today, a stronger tomorrow." styleClass="brand-quote" wrapText="true"/>
  </VBox>
  <StackPane HBox.hgrow="ALWAYS" styleClass="login-panel"><VBox maxWidth="560" spacing="18" styleClass="login-card"><padding><Insets top="42" right="54" bottom="42" left="54"/></padding>
   <Label text="WELCOME BACK" styleClass="login-kicker"/><Label text="Sign in to your account" styleClass="login-heading"/><Label text="Use your credentials to continue your journey." styleClass="login-subtitle" wrapText="true"/>
   <VBox spacing="8"><Label text="EMAIL ADDRESS" styleClass="field-label"/><TextField fx:id="emailField" promptText="Enter your email address" maxWidth="Infinity" styleClass="modern-field"/></VBox>
   <VBox spacing="8"><Label text="PASSWORD" styleClass="field-label"/><HBox spacing="8"><PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS" promptText="Enter your password" styleClass="modern-field"/><TextField fx:id="visiblePasswordField" managed="false" visible="false" HBox.hgrow="ALWAYS" promptText="Enter your password" styleClass="modern-field"/><ToggleButton fx:id="passwordToggle" text="Show" onAction="#togglePassword" styleClass="password-toggle"/></HBox></VBox>
   <VBox spacing="8"><Label text="LOGIN AS" styleClass="field-label"/><ComboBox fx:id="roleComboBox" maxWidth="Infinity" styleClass="modern-combo"/></VBox>
   <Button text="Sign in" maxWidth="Infinity" prefHeight="52" styleClass="primary-button" onAction="#loginUser"/>
   <HBox alignment="CENTER" spacing="6"><Label text="New to LoanFlow?" styleClass="small-text"/><Hyperlink text="Register as Customer" styleClass="register-link" onAction="#openRegister"/></HBox>
   <Separator/><Label text="Your account data is protected by secure verification." styleClass="security-note" wrapText="true"/>
  </VBox></StackPane>
 </HBox>
</StackPane>
