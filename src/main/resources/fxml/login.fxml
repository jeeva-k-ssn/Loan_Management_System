<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.loanmanagement.controller.LoginController" stylesheets="@../css/login.css" styleClass="login-root">
 <HBox maxWidth="1180" maxHeight="680" styleClass="login-shell">
  <StackPane prefWidth="620" styleClass="hero-panel">
   <ImageView fx:id="heroImage" fitWidth="620" fitHeight="680" preserveRatio="false"><image><Image url="@../images/login-hero-1.png"/></image></ImageView>
   <VBox alignment="TOP_LEFT" prefWidth="620" prefHeight="680" styleClass="hero-overlay"><padding><Insets top="38" right="46" bottom="38" left="46"/></padding>
    <Label text="LOANFLOW" styleClass="brand-logo"/>
    <VBox VBox.vgrow="ALWAYS" alignment="BOTTOM_LEFT" spacing="12"><Label fx:id="heroCaption" text="Build your next chapter." styleClass="hero-caption" wrapText="true"/><Label text="Simple borrowing. Clear progress. A better way forward." styleClass="hero-subtitle" wrapText="true"/><HBox fx:id="heroDots" spacing="7" styleClass="hero-dots"><Label text="●" styleClass="hero-dot active"/><Label text="●" styleClass="hero-dot"/><Label text="●" styleClass="hero-dot"/></HBox></VBox>
   </VBox>
  </StackPane>
  <VBox prefWidth="560" alignment="CENTER_LEFT" spacing="20" styleClass="login-panel"><padding><Insets top="58" right="78" bottom="58" left="78"/></padding>
   <Label text="GOOD TO SEE YOU" styleClass="login-kicker"/><Label text="Welcome back" styleClass="login-heading"/><Label text="Sign in securely to manage your loans and plans." styleClass="login-subtitle" wrapText="true"/>
   <VBox spacing="8" maxWidth="400"><Label text="EMAIL ADDRESS" styleClass="field-label"/><TextField fx:id="emailField" promptText="you@example.com" styleClass="modern-field"/></VBox>
   <VBox spacing="8" maxWidth="400"><Label text="PASSWORD" styleClass="field-label"/><PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="modern-field"/></VBox>
   <VBox spacing="8" maxWidth="400"><Label text="LOGIN AS" styleClass="field-label"/><ComboBox fx:id="roleComboBox" maxWidth="Infinity" styleClass="modern-combo"/></VBox>
   <Button text="Sign in" maxWidth="400" prefHeight="52" styleClass="primary-button" onAction="#loginUser"/>
   <HBox alignment="CENTER_LEFT" spacing="6"><Label text="New to LoanFlow?" styleClass="small-text"/><Hyperlink text="Create Customer Account" styleClass="register-link" onAction="#openRegister"/></HBox>
   <Label text="Protected by secure account verification" styleClass="security-note"/>
  </VBox>
 </HBox>
</StackPane>
