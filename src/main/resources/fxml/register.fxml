<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.loanmanagement.controller.RegisterController" stylesheets="@../css/login.css" styleClass="login-root">
    <VBox maxWidth="560" maxHeight="690" spacing="18" styleClass="register-card"><padding><Insets top="48" right="64" bottom="48" left="64"/></padding>
        <Label text="LoanFlow" styleClass="brand-logo-small"/><Label text="Create your account" styleClass="login-heading"/><Label text="Smarter Lending. Simpler Management." styleClass="login-subtitle"/>
        <VBox spacing="8"><Label text="FULL NAME" styleClass="field-label"/><TextField fx:id="nameField" promptText="Enter your full name" styleClass="modern-field"/></VBox>
        <VBox spacing="8"><Label text="EMAIL ADDRESS" styleClass="field-label"/><TextField fx:id="emailField" promptText="you@example.com" styleClass="modern-field"/></VBox>
        <VBox spacing="8"><Label text="PASSWORD" styleClass="field-label"/><PasswordField fx:id="passwordField" promptText="Minimum 6 characters" styleClass="modern-field"/></VBox>
        <VBox spacing="8"><Label text="CONFIRM PASSWORD" styleClass="field-label"/><PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password" styleClass="modern-field"/></VBox>
        <Label text="Customer accounts can be created here. Staff accounts are managed separately." styleClass="registration-note" wrapText="true"/>
        <Button text="Create customer account" maxWidth="Infinity" prefHeight="50" styleClass="primary-button" onAction="#registerUser"/>
        <HBox alignment="CENTER" spacing="6"><Label text="Already have an account?" styleClass="small-text"/><Hyperlink text="Back to Login" styleClass="register-link" onAction="#openLogin"/></HBox>
    </VBox>
</StackPane>
