<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.loanmanagement.controller.ProfileController" stylesheets="@../css/dashboard.css" styleClass="dashboard-root">
  <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar"><padding><Insets top="16" right="28" bottom="16" left="28"/></padding><VBox><Label text="LoanFlow" styleClass="dashboard-logo"/><Label text="CUSTOMER PROFILE" styleClass="dashboard-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh" styleClass="refresh-button"/><Button text="Back to Dashboard" onAction="#back" styleClass="logout-button"/></HBox></top>
  <center><ScrollPane fitToWidth="true" styleClass="dashboard-scroll"><VBox spacing="16"><padding><Insets top="28" right="35" bottom="35" left="35"/></padding><VBox spacing="5"><Label text="Your profile" styleClass="page-title"/><Label text="Manage your verified account details and view your lending summary." styleClass="page-description"/></VBox>
    <HBox spacing="18"><VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="content-card"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><Label text="Personal information" styleClass="section-title"/><Label text="Customer ID" styleClass="field-label"/><Label fx:id="customerIdLabel" text="-" styleClass="summary-value"/><Label text="Full name" styleClass="field-label"/><TextField fx:id="nameField" styleClass="modern-field"/><Label text="Email" styleClass="field-label"/><TextField fx:id="emailField" styleClass="modern-field"/><Label text="Phone" styleClass="field-label"/><TextField fx:id="phoneField" promptText="Optional phone number" styleClass="modern-field"/><Label text="Address" styleClass="field-label"/><TextArea fx:id="addressField" prefRowCount="3" wrapText="true" styleClass="modern-field"/><Button text="Save changes" onAction="#save" styleClass="action-button"/><Label fx:id="messageLabel" text="" styleClass="section-description" wrapText="true"/></VBox>
      <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="content-card"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><Label text="Application summary" styleClass="section-title"/><Label text="Total applications" styleClass="field-label"/><Label fx:id="applicationsLabel" text="-" styleClass="summary-value"/><Label text="Pending" styleClass="field-label"/><Label fx:id="pendingLabel" text="-" styleClass="summary-value"/><Label text="Approved" styleClass="field-label"/><Label fx:id="approvedLabel" text="-" styleClass="summary-value"/><Label text="Rejected" styleClass="field-label"/><Label fx:id="rejectedLabel" text="-" styleClass="summary-value"/></VBox></HBox>
    <VBox spacing="10" styleClass="content-card"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><Label text="Loan summary" styleClass="section-title"/><GridPane hgap="24" vgap="12"><Label text="Active loans" styleClass="field-label"/><Label fx:id="activeLoansLabel" text="-" styleClass="summary-value" GridPane.columnIndex="1"/><Label text="Closed loans" styleClass="field-label" GridPane.columnIndex="2"/><Label fx:id="closedLoansLabel" text="-" styleClass="summary-value" GridPane.columnIndex="3"/><Label text="Total borrowed" styleClass="field-label" GridPane.rowIndex="1"/><Label fx:id="borrowedLabel" text="-" styleClass="summary-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="Total paid" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/><Label fx:id="paidLabel" text="-" styleClass="summary-value" GridPane.columnIndex="3" GridPane.rowIndex="1"/><Label text="Outstanding" styleClass="field-label" GridPane.rowIndex="2"/><Label fx:id="outstandingLabel" text="-" styleClass="summary-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/></GridPane></VBox>
    <VBox spacing="10" styleClass="content-card"><padding><Insets top="20" right="20" bottom="20" left="20"/></padding><Label text="Recent activity" styleClass="section-title"/><ListView fx:id="activityList" prefHeight="180"><placeholder><Label text="No recent activity yet." styleClass="empty-label"/></placeholder></ListView></VBox>
  </VBox></ScrollPane></center>
</BorderPane>
